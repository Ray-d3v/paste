<Window
    x:Class="PasteWinUI.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    Title="PasteWinUI">
    <Grid
        x:Name="Root"
        Background="Transparent"
        PointerPressed="Root_PointerPressed"
        PointerWheelChanged="Root_PointerWheelChanged"
        KeyDown="Root_KeyDown">
        <Grid
            x:Name="OverlayPanel"
            Margin="0"
            Background="Transparent"
            PointerPressed="OverlayPanel_PointerPressed">
            <Rectangle
                IsHitTestVisible="False"
                RadiusX="22"
                RadiusY="22">
                <Rectangle.Fill>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                        <GradientStop Color="#E111161B" Offset="0.00" />
                        <GradientStop Color="#E3141A20" Offset="0.50" />
                        <GradientStop Color="#EC171D23" Offset="1.00" />
                    </LinearGradientBrush>
                </Rectangle.Fill>
            </Rectangle>
            <Rectangle
                IsHitTestVisible="False"
                RadiusX="22"
                RadiusY="22"
                Fill="#07273339" />
            <Rectangle
                IsHitTestVisible="False"
                RadiusX="22"
                RadiusY="22">
                <Rectangle.Fill>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                        <GradientStop Color="#06000000" Offset="0.00" />
                        <GradientStop Color="#00000000" Offset="0.28" />
                        <GradientStop Color="#24000000" Offset="1.00" />
                    </LinearGradientBrush>
                </Rectangle.Fill>
            </Rectangle>

            <Grid
                x:Name="SearchHeaderPanel"
                Width="460"
                HorizontalAlignment="Center"
                VerticalAlignment="Top"
                Margin="20,12,20,0">
                <StackPanel
                    x:Name="SearchCompactControls"
                    Orientation="Horizontal"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    Spacing="8">
                <Button
                    x:Name="SearchToggleButton"
                    Width="28"
                    Height="28"
                    Padding="0"
                    HorizontalAlignment="Center"
                    HorizontalContentAlignment="Center"
                    VerticalContentAlignment="Center"
                    CornerRadius="14"
                    Background="#FF0F1418"
                    BorderBrush="#FF2A343E"
                    BorderThickness="1"
                    Click="SearchToggleButton_Click">
                    <FontIcon
                        Glyph="&#xE721;"
                        FontFamily="Segoe MDL2 Assets"
                        FontSize="11"
                        Margin="-1,0,0,0"
                        Foreground="#FFF3F4F1" />
                </Button>
                <StackPanel
                    x:Name="PinnedGroupTabs"
                    Orientation="Horizontal"
                    Spacing="6">
                    <Button
                        x:Name="PinnedGroupAllButton"
                        Tag="all"
                        Height="28"
                        Padding="8,0,8,0"
                        CornerRadius="14"
                        Background="#FF0F1418"
                        BorderBrush="#FF2A343E"
                        BorderThickness="1"
                        Click="PinnedGroupFilterButton_Click">
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <Ellipse Width="7" Height="7" Fill="#FF7A858F" VerticalAlignment="Center" />
                            <TextBlock Text="All" FontSize="11.5" FontWeight="SemiBold" Foreground="#FFF3F4F1" />
                        </StackPanel>
                    </Button>
                    <Button
                        x:Name="PinnedGroupQuickButton"
                        Tag="quick"
                        Height="28"
                        Padding="8,0,8,0"
                        CornerRadius="14"
                        Background="#FF0F1418"
                        BorderBrush="#FF2A343E"
                        BorderThickness="1"
                        Click="PinnedGroupFilterButton_Click">
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <Ellipse Width="7" Height="7" Fill="#FFC4A06B" VerticalAlignment="Center" />
                            <TextBlock Text="Quick" FontSize="11.5" FontWeight="SemiBold" Foreground="#FFF3F4F1" />
                        </StackPanel>
                    </Button>
                    <Button
                        x:Name="PinnedGroupWorkButton"
                        Tag="work"
                        Height="28"
                        Padding="8,0,8,0"
                        CornerRadius="14"
                        Background="#FF0F1418"
                        BorderBrush="#FF2A343E"
                        BorderThickness="1"
                        Click="PinnedGroupFilterButton_Click">
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <Ellipse Width="7" Height="7" Fill="#FF7FB59D" VerticalAlignment="Center" />
                            <TextBlock Text="Work" FontSize="11.5" FontWeight="SemiBold" Foreground="#FFF3F4F1" />
                        </StackPanel>
                    </Button>
                    <Button
                        x:Name="PinnedGroupIdeaButton"
                        Tag="idea"
                        Height="28"
                        Padding="8,0,8,0"
                        CornerRadius="14"
                        Background="#FF0F1418"
                        BorderBrush="#FF2A343E"
                        BorderThickness="1"
                        Click="PinnedGroupFilterButton_Click">
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <Ellipse Width="7" Height="7" Fill="#FF88A9C9" VerticalAlignment="Center" />
                            <TextBlock Text="Idea" FontSize="11.5" FontWeight="SemiBold" Foreground="#FFF3F4F1" />
                        </StackPanel>
                    </Button>
                </StackPanel>
                </StackPanel>

                <Border
                    x:Name="SearchBarShell"
                    Width="330"
                    Height="40"
                    HorizontalAlignment="Center"
                    Visibility="Collapsed"
                    Opacity="0"
                    CornerRadius="20"
                    BorderBrush="#FF313C46"
                    BorderThickness="1">
                    <Border.Background>
                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                            <GradientStop Color="#F0161B20" Offset="0.00" />
                            <GradientStop Color="#F0171D23" Offset="0.55" />
                            <GradientStop Color="#F0192026" Offset="1.00" />
                        </LinearGradientBrush>
                    </Border.Background>
                    <Border.RenderTransform>
                        <ScaleTransform
                            x:Name="SearchBarScaleTransform"
                            ScaleX="0.65"
                            ScaleY="0.96"
                            CenterX="165"
                            CenterY="20" />
                    </Border.RenderTransform>
                    <Grid Padding="12,0,10,0" VerticalAlignment="Center">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <FontIcon
                            Grid.Column="0"
                            Glyph="&#xE721;"
                            FontFamily="Segoe MDL2 Assets"
                            FontSize="12"
                            Foreground="#FFB5BEC6"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center" />

                        <TextBox
                            x:Name="SearchTextBox"
                            Grid.Column="1"
                            Margin="10,2,0,-2"
                            MinHeight="22"
                            HorizontalAlignment="Stretch"
                            VerticalAlignment="Center"
                            VerticalContentAlignment="Center"
                            Padding="0,3,0,0"
                            PlaceholderText="Search clipboard history"
                            PlaceholderForeground="#FFE5E7EB"
                            Background="Transparent"
                            BorderBrush="Transparent"
                            BorderThickness="0"
                            Foreground="#FFFFFFFF"
                            IsEnabled="False"
                            TextChanged="SearchTextBox_TextChanged"
                            KeyDown="SearchTextBox_KeyDown">
                            <TextBox.Resources>
                                <SolidColorBrush x:Key="TextControlBackground" Color="Transparent" />
                                <SolidColorBrush x:Key="TextControlBackgroundFocused" Color="Transparent" />
                                <SolidColorBrush x:Key="TextControlBackgroundPointerOver" Color="Transparent" />
                                <SolidColorBrush x:Key="TextControlBackgroundDisabled" Color="Transparent" />
                                <SolidColorBrush x:Key="TextControlForeground" Color="#FFFFFFFF" />
                                <SolidColorBrush x:Key="TextControlForegroundFocused" Color="#FFFFFFFF" />
                                <SolidColorBrush x:Key="TextControlForegroundPointerOver" Color="#FFFFFFFF" />
                                <SolidColorBrush x:Key="TextControlForegroundDisabled" Color="#FF9AA5AF" />
                                <SolidColorBrush x:Key="TextControlBorderBrush" Color="Transparent" />
                                <SolidColorBrush x:Key="TextControlBorderBrushFocused" Color="Transparent" />
                                <SolidColorBrush x:Key="TextControlBorderBrushPointerOver" Color="Transparent" />
                                <SolidColorBrush x:Key="TextControlPlaceholderForeground" Color="#FFE5E7EB" />
                                <Thickness x:Key="TextControlBorderThemeThickness">0</Thickness>
                                <Thickness x:Key="TextControlBorderThemeThicknessFocused">0</Thickness>
                            </TextBox.Resources>
                        </TextBox>

                        <Button
                            x:Name="SearchCloseButton"
                            Grid.Column="2"
                            Width="22"
                            Height="22"
                            Padding="0"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center"
                            HorizontalContentAlignment="Center"
                            VerticalContentAlignment="Center"
                            Background="Transparent"
                            BorderBrush="Transparent"
                            BorderThickness="0"
                            CornerRadius="11"
                            Click="SearchCloseButton_Click">
                            <FontIcon
                                Glyph="&#xE711;"
                                FontFamily="Segoe MDL2 Assets"
                                FontSize="10"
                                Foreground="#FF8A97A2" />
                        </Button>
                    </Grid>
                </Border>
            </Grid>

            <Button
                x:Name="TrashToggleButton"
                Width="34"
                Height="28"
                Padding="0"
                Margin="0,12,22,0"
                HorizontalAlignment="Right"
                VerticalAlignment="Top"
                HorizontalContentAlignment="Center"
                VerticalContentAlignment="Center"
                CornerRadius="14"
                Background="#FF0F1418"
                BorderBrush="#FF2A343E"
                BorderThickness="1"
                Click="TrashToggleButton_Click">
                <FontIcon
                    Glyph="&#xE74D;"
                    FontFamily="Segoe MDL2 Assets"
                    FontSize="12"
                    Foreground="#FFF3F4F1" />
            </Button>

            <ScrollViewer
                x:Name="CardScroller"
                Margin="20,54,20,20"
                Background="Transparent"
                BorderBrush="Transparent"
                BorderThickness="0"
                Padding="0"
                HorizontalScrollMode="Enabled"
                HorizontalScrollBarVisibility="Hidden"
                VerticalScrollMode="Disabled"
                VerticalScrollBarVisibility="Disabled"
                ZoomMode="Disabled"
                VerticalAlignment="Stretch"
                HorizontalAlignment="Stretch"
                IsHorizontalRailEnabled="True"
                IsVerticalRailEnabled="False">
                <ScrollViewer.Resources>
                    <SolidColorBrush x:Key="ScrollViewerBackground" Color="Transparent" />
                    <SolidColorBrush x:Key="ScrollViewerBorderBrush" Color="Transparent" />
                    <SolidColorBrush x:Key="ScrollViewerSeparatorBorderBrush" Color="Transparent" />
                    <Thickness x:Key="ScrollViewerBorderThemeThickness">0</Thickness>
                    <Thickness x:Key="ScrollViewerDefaultBorderThickness">0</Thickness>
                </ScrollViewer.Resources>
                <StackPanel
                    x:Name="CardRow"
                    Orientation="Horizontal"
                    VerticalAlignment="Bottom"
                    Spacing="12" />
            </ScrollViewer>

            <Border
                x:Name="EmptyStatePanel"
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                MinWidth="320"
                MaxWidth="520"
                Padding="18,14"
                CornerRadius="14"
                Visibility="Collapsed"
                Background="#FF171D23"
                BorderBrush="#FF394651"
                BorderThickness="1"
                IsHitTestVisible="False">
                <StackPanel
                    Width="Auto"
                    MaxWidth="420"
                    HorizontalAlignment="Stretch"
                    Spacing="6">
                    <TextBlock
                        x:Name="EmptyStateTitleText"
                        Text="No clipboard items yet"
                        FontSize="15"
                        FontWeight="SemiBold"
                        Foreground="#FFF3F4F1"
                        TextAlignment="Center"
                        TextWrapping="WrapWholeWords" />
                    <TextBlock
                        x:Name="EmptyStateBodyText"
                        Text="Copy something and open with Ctrl+Alt+V. Use Ctrl+F to search."
                        FontSize="12.5"
                        Foreground="#FFB5BEC6"
                        TextAlignment="Center"
                        TextWrapping="WrapWholeWords" />
                </StackPanel>
            </Border>

            <Popup
                x:Name="CardPreviewPopup"
                IsLightDismissEnabled="False">
                <StackPanel
                    x:Name="CardPreviewBubble"
                    Spacing="0"
                    MaxWidth="460">
                    <Border
                        Background="#FF1B2229"
                        BorderBrush="#FF394651"
                        BorderThickness="1"
                        CornerRadius="14"
                        Padding="14,12,14,12">
                        <StackPanel Spacing="8">
                            <TextBlock
                                x:Name="CardPreviewTitleText"
                                FontSize="12"
                                FontWeight="SemiBold"
                                Foreground="#FFF3F4F1"
                                TextTrimming="CharacterEllipsis"
                                MaxLines="1" />
                            <Image
                                x:Name="CardPreviewImage"
                                Height="180"
                                Stretch="UniformToFill"
                                Visibility="Collapsed"
                                HorizontalAlignment="Stretch" />
                            <ScrollViewer
                                MaxHeight="220"
                                VerticalScrollBarVisibility="Auto"
                                HorizontalScrollBarVisibility="Disabled">
                                <TextBlock
                                    x:Name="CardPreviewBodyText"
                                    FontSize="13"
                                    Foreground="#FFB5BEC6"
                                    TextWrapping="WrapWholeWords"
                                    LineHeight="20" />
                            </ScrollViewer>
                        </StackPanel>
                    </Border>
                    <Polygon
                        Points="0,0 14,0 7,8"
                        Fill="#FF1B2229"
                        Stroke="#FF394651"
                        StrokeThickness="1"
                        HorizontalAlignment="Center"
                        Margin="0,-1,0,0" />
                </StackPanel>
            </Popup>

            <Popup
                x:Name="CardContextPopup"
                IsLightDismissEnabled="False"
                Closed="CardContextPopup_Closed">
                <Border
                    x:Name="CardContextPopupPanel"
                    Background="#FF1B2229"
                    BorderBrush="#FF394651"
                    BorderThickness="1"
                    CornerRadius="10"
                    Padding="6">
                    <StackPanel Spacing="4">
                        <Button
                            x:Name="CardContextPinQuickButton"
                            Content="Pin to Quick"
                            MinWidth="150"
                            HorizontalAlignment="Stretch"
                            HorizontalContentAlignment="Left"
                            Padding="10,6"
                            CornerRadius="8"
                            Background="Transparent"
                            BorderThickness="1"
                            BorderBrush="Transparent"
                            Foreground="#FFF3F4F1"
                            Click="CardContextPinQuickButton_Click" />
                        <Button
                            x:Name="CardContextPinWorkButton"
                            Content="Pin to Work"
                            MinWidth="150"
                            HorizontalAlignment="Stretch"
                            HorizontalContentAlignment="Left"
                            Padding="10,6"
                            CornerRadius="8"
                            Background="Transparent"
                            BorderThickness="1"
                            BorderBrush="Transparent"
                            Foreground="#FFF3F4F1"
                            Click="CardContextPinWorkButton_Click" />
                        <Button
                            x:Name="CardContextPinIdeaButton"
                            Content="Pin to Idea"
                            MinWidth="150"
                            HorizontalAlignment="Stretch"
                            HorizontalContentAlignment="Left"
                            Padding="10,6"
                            CornerRadius="8"
                            Background="Transparent"
                            BorderThickness="1"
                            BorderBrush="Transparent"
                            Foreground="#FFF3F4F1"
                            Click="CardContextPinIdeaButton_Click" />
                        <Button
                            x:Name="CardContextUnpinButton"
                            Content="Unpin"
                            MinWidth="150"
                            HorizontalAlignment="Stretch"
                            HorizontalContentAlignment="Left"
                            Padding="10,6"
                            CornerRadius="8"
                            Background="Transparent"
                            BorderThickness="1"
                            BorderBrush="Transparent"
                            Foreground="#FFF3F4F1"
                            Click="CardContextUnpinButton_Click" />
                        <Button
                            x:Name="CardContextPasteModeButton"
                            Content="Paste Mode: As-is"
                            MinWidth="150"
                            HorizontalAlignment="Stretch"
                            HorizontalContentAlignment="Left"
                            Padding="10,6"
                            CornerRadius="8"
                            Background="Transparent"
                            BorderThickness="1"
                            BorderBrush="Transparent"
                            Foreground="#FFF3F4F1"
                            Click="CardContextPasteModeButton_Click" />
                        <Button
                            x:Name="CardContextRestoreButton"
                            Content="Restore"
                            MinWidth="150"
                            HorizontalAlignment="Stretch"
                            HorizontalContentAlignment="Left"
                            Padding="10,6"
                            CornerRadius="8"
                            Background="Transparent"
                            BorderThickness="1"
                            BorderBrush="Transparent"
                            Foreground="#FFF3F4F1"
                            Visibility="Collapsed"
                            Click="CardContextRestoreButton_Click" />
                        <Button
                            x:Name="CardContextDeleteButton"
                            Content="Move to Trash"
                            MinWidth="150"
                            HorizontalAlignment="Stretch"
                            HorizontalContentAlignment="Left"
                            Padding="10,6"
                            CornerRadius="8"
                            Background="Transparent"
                            BorderThickness="1"
                            BorderBrush="Transparent"
                            Foreground="#FFF3F4F1"
                            Click="CardContextDeleteButton_Click" />
                    </StackPanel>
                </Border>
            </Popup>

            <Border
                x:Name="ToastPanel"
                HorizontalAlignment="Center"
                VerticalAlignment="Bottom"
                Margin="20,0,20,16"
                Padding="12,8"
                CornerRadius="10"
                Visibility="Collapsed"
                Background="#FF171D23"
                BorderBrush="#FF394651"
                BorderThickness="1">
                <Grid ColumnSpacing="10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock
                        x:Name="ToastMessageText"
                        Grid.Column="0"
                        VerticalAlignment="Center"
                        FontSize="12.5"
                        Foreground="#FFF3F4F1"
                        Text="Done" />
                    <Button
                        x:Name="ToastActionButton"
                        Grid.Column="1"
                        Padding="8,2"
                        MinWidth="64"
                        CornerRadius="8"
                        Visibility="Collapsed"
                        Background="#FF0F1418"
                        BorderBrush="#FF394651"
                        BorderThickness="1"
                        Foreground="#FFF3F4F1"
                        Click="ToastActionButton_Click"
                        Content="Undo" />
                </Grid>
            </Border>
        </Grid>
    </Grid>
</Window>
